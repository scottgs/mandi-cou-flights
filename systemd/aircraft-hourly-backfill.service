[Unit]
Description=Hourly historical catch-up for tracked aircraft (N8382A, N2169F) via OpenSky
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=__INSTALL_USER__
EnvironmentFile=/etc/mandi/cou-flights.env
Environment=HA_WWW_DIR=__HA_WWW_DIR__
ExecStart=/usr/bin/python3 __REPO_DIR__/fetch/aircraft-hourly-backfill.py N8382A N2169F
