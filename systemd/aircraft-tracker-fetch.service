[Unit]
Description=Track aircraft (N8382A, N2169F) via OpenSky for the MANDI HA dashboard
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=__INSTALL_USER__
EnvironmentFile=/etc/mandi/cou-flights.env
Environment=HA_WWW_DIR=__HA_WWW_DIR__
ExecStart=/usr/bin/python3 __REPO_DIR__/fetch/aircraft-tracker-fetch.py N8382A N2169F
